# =============================================================
# Philipeia Backend — variáveis de ambiente
# Copie para .env e preencha os valores reais
# NUNCA commite o .env com dados reais
# =============================================================

# JWT
JWT_SECRET=troque-por-string-aleatoria-de-64-chars
JWT_EXPIRY_HOURS=8

# Admin (único usuário do sistema)
ADMIN_EMAIL=admin@philipeia.com.br
ADMIN_PASSWORD_HASH=      # gerar com: python -c "import bcrypt; print(bcrypt.hashpw(b'suasenha', bcrypt.gensalt()).decode())"

# SQL Server
DB_SERVER=localhost
DB_NAME=philipeia
DB_USER=sa
DB_PASSWORD=suasenha
DB_DRIVER=ODBC Driver 17 for SQL Server

# SMTP Gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@philipeia.com.br
SMTP_APP_PASSWORD=          # 16 chars — gerar em: Conta Google > Segurança > Senhas de app
EMAIL_FROM_NAME=Philipeia Indústria
