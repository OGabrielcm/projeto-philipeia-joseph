# =============================================================
# Philipeia Backend — variáveis de ambiente
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o .env (já está no .gitignore).
# =============================================================

# ----- Autenticação JWT -----
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=TROQUE_POR_UMA_STRING_ALEATORIA_LONGA
JWT_EXPIRY_HOURS=8

# ----- Credenciais do administrador -----
ADMIN_EMAIL=admin@exemplo.com
# Gere com: python -c "import bcrypt; print(bcrypt.hashpw(b'suasenha', bcrypt.gensalt(12)).decode())"
ADMIN_PASSWORD_HASH=HASH_BCRYPT_DA_SENHA

# ----- Banco de dados (SQL Server Express) -----
# Windows Auth: deixe DB_USER e DB_PASSWORD em branco (recomendado para dev local)
# SQL Auth:     preencha DB_USER e DB_PASSWORD
DB_SERVER=.\SQLEXPRESS
DB_NAME=philipeia
DB_DRIVER=SQL Server
DB_USER=
DB_PASSWORD=

# ----- E-mail para recuperação de senha (opcional) -----
# Gmail: ative "Senhas de app" em myaccount.google.com/security
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email@gmail.com
SMTP_APP_PASSWORD=xxxx xxxx xxxx xxxx
EMAIL_FROM_NAME=Philipeia Indústria
